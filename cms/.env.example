# Leave DATABASE_URL empty for local SQLite prototyping.
# Set it to Supabase Postgres when testing/deploying against Supabase.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
# Local file path for development, or use SUPABASE_DB_CA_CERT_TEXT in Vercel.
SUPABASE_DB_CA_CERT=./prod-ca-2021.crt
SUPABASE_DB_CA_CERT_TEXT=
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3334

# Cloudflare R2, compatible through Payload's S3 adapter.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.logiaabierta.com
