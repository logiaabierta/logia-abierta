---
import Image from "astro/components/Image.astro";
import { Icon } from "astro-icon/components";
import Layout from "../../../layouts/Base.astro";
import { r2Asset } from "../../../lib/r2Assets";
import { formatDate } from "../../../utils/dateFormatter";
import PodcastCard from "../../../components/PodcastCard.astro";
import { getCollection, render } from "astro:content";

import { LOCALES } from "../../../i18n";

export async function getStaticPaths() {
  const paths = [];

  for (const lang of Object.keys(LOCALES)) {
    const podcasts = (await getCollection("podcasts"))
      .filter((entry) => entry.data.status === "published" && entry.data.lang === lang)
      .map((entry) => ({
        entry,
        podcast: {
          title: entry.data.title,
          _createdAt: entry.data.pubDate,
          duration: entry.data.duration || 0,
          episod: entry.data.episode || 0,
          description: entry.data.description,
          language: entry.data.lang,
          slug: entry.id.replace(/\.(md|mdx)$/, ""),
          image: entry.data.thumbnailUrl,
          imageAlt: entry.data.thumbnailAlt,
          audioUrl: entry.data.audioUrl,
          spotifyUrl: entry.data.spotifyUrl,
          youtubeUrl: entry.data.youtubeUrl,
        },
      }));

    for (const { entry, podcast } of podcasts) {
      paths.push({
        params: {
          lang,
          slug: podcast.slug,
        },
        props: {
          podcast,
          entry,
        },
      });
    }
  }

  return paths;
}

const locale = Astro.params.lang;
const { podcast, entry } = Astro.props;
const { Content } = await render(entry);

const relatedPodcasts = (await getCollection("podcasts"))
  .filter((item) => item.data.status === "published" && item.data.lang === locale && item.id.replace(/\.(md|mdx)$/, "") !== podcast.slug)
  .map((item) => ({
    title: item.data.title,
    duration: item.data.duration || 0,
    episod: item.data.episode || 0,
    _createdAt: item.data.pubDate,
    slug: item.id.replace(/\.(md|mdx)$/, ""),
    image: item.data.thumbnailUrl,
  }))
  .sort((a, b) => new Date(b._createdAt).getTime() - new Date(a._createdAt).getTime())
  .slice(0, 3);

const socials = [
  {
    url: podcast.spotifyUrl || "https://open.spotify.com/show/logiaabierta",
    title: "Spotify",
    icon: "simple-icons:spotify",
  },
  {
    url: podcast.youtubeUrl || "https://www.youtube.com/@logiaabierta/videos",
    title: "YouTube",
    icon: "simple-icons:youtube",
  },
  {
    url: "https://logiaabierta.substack.com",
    title: "Substack",
    icon: "simple-icons:substack",
  },
].filter((item) => item.url);
---

<Layout
  title={podcast.title}
  description={podcast.description}
  image={podcast?.image || ""}
>
  <section class="mt-10">
    <div class="container">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <a
          href={`/${locale}/podcast`}
          class="btn btn-link text-inherit uppercase no-underline group p-0"
        >
          <Icon name="lucide:arrow-left" aria-hidden="true" class="size-4 transition group-hover:translate-x-1" />
          Go Back
        </a>

        <p class="font-semibold text-3xl uppercase">PODCAST</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div
        class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[350px_1fr] gap-x-20 gap-y-10"
      >
        <aside>
          <div class="grid">
            {
              podcast?.image && (
                <Image
                  src={podcast.image}
                  alt={podcast.title}
                  width="369"
                  height="462"
                  format="webp"
                  quality={80}
                  class="w-full h-auto [grid-area:1/1/2/2]"
                />
              )
            }

            <div
              class="flex flex-col justify-between [grid-area:1/1/2/2] text-white p-4 lg:p-10"
            >
              <div>
                <p class="text-4xl xl:text-6xl leading-[0.8]">LOGIA</p>
                <p class="text-4xl xl:text-6xl leading-[0.8]">ABIERTA</p>
                <p class="uppercase text-xl xl:text-3xl mt-4">Podcast</p>
              </div>

              <div class="flex justify-between items-end">
                <div>
                  <p class="text-3xl uppercase">
                    Ep {podcast?.episod}
                  </p>
                </div>

                <div>
                  <img
                    src={r2Asset("/img/icons/arrow.svg")}
                    alt=""
                    width="46"
                    height="46"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          </div>

          <div
            class="border-b pb-5 mt-10 flex flex-wrap items-center justify-between gap-4"
          >
            <div>
              <b>Listen On</b>
            </div>

            <nav class="flex items-center gap-3 flex-wrap">
              {
                socials.map((icon) => (
                  <a
                    href={icon.url}
                    title={icon.title}
                    class="hover:rotate-12"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name={icon.icon} aria-hidden="true" class="size-4" />
                  </a>
                ))
              }
            </nav>
          </div>

          <div class="mt-5 grid gap-4">
            <div class="grid grid-cols-[1fr_auto] gap-2">
              <b>Date</b>
              <span>{formatDate(podcast._createdAt)}</span>
            </div>

            <div class="grid grid-cols-[1fr_auto] gap-2">
              <b>Duration</b>
              <span>{podcast?.duration}</span>
            </div>

            <div class="grid grid-cols-[1fr_auto] gap-2">
              <b>Share</b>

              <nav class="flex items-center gap-3 flex-wrap">
                {
                  socials.map((icon) => (
                    <a
                      href={icon.url}
                      title={icon.title}
                      class="hover:rotate-12"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <Icon name={icon.icon} aria-hidden="true" class="size-4" />
                    </a>
                  ))
                }
              </nav>
            </div>
          </div>
        </aside>

        <div class="post" data-motion-reveal>
          <div>
            <p class="font-semibold uppercase mb-3">
              Episode {podcast?.episod}
            </p>

            <h1 class="mb-6">{podcast?.title}</h1>
          </div>

          <p class="text-lg my-10 font-semibold">
            {podcast?.description}
          </p>
          {podcast.audioUrl && (
            <audio controls preload="metadata" src={podcast.audioUrl} class="w-full mb-10"></audio>
          )}
          <Content />
        </div>
      </div>
    </div>
  </section>

  {
    relatedPodcasts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="border-t pt-10">
            <div class="flex flex-wrap gap-4 justify-between items-center">
              <h2 class="uppercase">Latest Episodes</h2>

              <a
                href={`/${locale}/podcast`}
                class="btn btn-link text-inherit uppercase no-underline group p-0"
              >
                All Episodes
                <Icon name="lucide:arrow-right" aria-hidden="true" class="size-4 transition group-hover:translate-x-1" />
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mt-10">
              {relatedPodcasts.map((item) => (
                <PodcastCard {...item} />
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }
</Layout>
