---
import Layout from "../../../layouts/Base.astro";
import Hero from "../../../components/Hero.astro";
import PodcastCardRow from "../../../components/PodcastCardRow.astro";
import Pagination from "../../../components/Pagination.astro";
import { getCollection } from "astro:content";

import { LOCALES } from "../../../i18n";

export async function getStaticPaths({ paginate }) {
  const paths = [];

  for (const lang of Object.keys(LOCALES)) {
    const podcasts = (await getCollection("podcasts"))
      .filter((podcast) => podcast.data.status === "published" && podcast.data.lang === lang)
      .map((podcast) => ({
        title: podcast.data.title,
        _createdAt: podcast.data.pubDate,
        duration: podcast.data.duration || 0,
        episod: podcast.data.episode || 0,
        slug: podcast.id.replace(/\.(md|mdx)$/, ""),
        image: podcast.data.thumbnailUrl,
      }))
      .sort((a, b) => new Date(b._createdAt).getTime() - new Date(a._createdAt).getTime());

    const paginated = paginate(podcasts, {
      pageSize: 6,

      params: {
        lang,
      },
    });

    paths.push(...paginated);
  }

  return paths;
}

const locale = Astro.params.lang;

const { page } = Astro.props;

const totalPages = Math.ceil(page.total / page.size);
---

<Layout title="Podcast">
  <Hero title="Podcast" />

  <section class="section">
    <div class="container">
      <ul class="grid gap-10 mb-10">
        {
          page.data.map((post, index) => (
            <li class="border-b pb-10 last:border-b-0 last:pb-0">
              <PodcastCardRow {...post} index={index} />
            </li>
          ))
        }
      </ul>

      {totalPages > 1 && <Pagination totalPages={totalPages} page={page} />}
    </div>
  </section>
</Layout>
