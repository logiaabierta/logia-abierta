---
import { Icon } from "astro-icon/components";
import Layout from "../../../../layouts/Base.astro";
import Hero from "../../../../components/Hero.astro";
import PostCard from "../../../../components/PostCardBase.astro";
import Pagination from "../../../../components/Pagination.astro";
import { getBlogPosts, getCategories } from "../../../../lib/editorialContent";
import { LOCALES } from "../../../../i18n";

export async function getStaticPaths({ paginate }) {
  const paths = [];

  for (const lang of Object.keys(LOCALES)) {
    const categories = await getCategories(lang);
    const posts = await getBlogPosts(lang);

    for (const category of categories) {
      const categoryPosts = posts.filter((post) => post.category?.slug === category.slug);
      const paginated = paginate(categoryPosts, {
        pageSize: 6,
        params: {
          lang,
          category: category.slug,
        },
        props: {
          categoryTitle: category.title,
        },
      });

      paths.push(...paginated);
    }
  }

  return paths;
}

const locale = Astro.params.lang;
const { page, categoryTitle } = Astro.props;
const totalPages = Math.ceil(page.total / page.size);
---

<Layout title={`Blog | category: ${categoryTitle}`}>
  <Hero title="Magazine" />

  <section class="mt-10">
    <div class="container">
      <div class="flex flex-wrap justify-between items-center gap-4 mb-10">
        <a
          href={`/${locale}/blog`}
          class="btn btn-link text-inherit uppercase no-underline group p-0"
        >
          <Icon name="lucide:arrow-left" aria-hidden="true" class="size-4 transition group-hover:translate-x-1" />
          Go Back
        </a>

        <h1 class="h2 w-full lg:w-auto">
          Category: {categoryTitle}
        </h1>

        <p>
          Page {page.currentPage} of {totalPages}
        </p>
      </div>

      {
        page.data.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mb-10">
            {page.data.map((post) => <PostCard {...post} />)}
          </div>
        ) : (
          <p class="py-10">No hay artículos publicados en esta categoría todavía.</p>
        )
      }

      {
        totalPages > 1 && (
          <div class="mb-10">
            <Pagination totalPages={totalPages} page={page} />
          </div>
        )
      }
    </div>
  </section>
</Layout>
