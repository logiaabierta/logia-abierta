---
import Image from "astro/components/Image.astro";
import Layout from "../../../layouts/Base.astro";
import { client } from "../../../lib/sanity";
import PostCardBase from "../../../components/PostCardBase.astro";
import PortableComponent from "../../../components/builder/PortableComponent.astro";
import { formatDate } from "../../../utils/dateFormatter";
import { toPlainText } from "astro-portabletext";
import { SITE_TITLE, SITE_URL } from "../../../consts";

import { LOCALES } from "../../../i18n";

export async function getStaticPaths() {
  const paths = [];

  for (const lang of Object.keys(LOCALES)) {
    const posts = await client.fetch(
      `
      *[
        _type == "post" &&
        language == $lang
      ]{
        title,
        description,
        seoTitle,
        seoDescription,
        ogTitle,
        ogDescription,
        canonicalUrl,
        noindex,
        duration,
        publishedAt,
        body,
        enableFaqSchema,
        faqs[]{
          question,
          answer
        },
        _createdAt,
        _updatedAt,
        language,
        "slug": slug.current,

        "image": coalesce(
          mainImage.asset->url,
          thumbnail.asset->url
        ),
        "imageAlt": coalesce(
          mainImage.alt,
          thumbnail.alt,
          title
        ),
        "socialImage": coalesce(
          socialImage.asset->url,
          mainImage.asset->url,
          thumbnail.asset->url
        ),
        "socialImageAlt": coalesce(
          socialImage.alt,
          mainImage.alt,
          thumbnail.alt,
          title
        ),
        "alternatePosts": *[_type == "translation.metadata" && references(^._id)][0].translations[].value->{
          language,
          "slug": slug.current
        },

        "author": author->{
          name,
          "slug": slug.current,
          "image": image.asset->url
        },

        "categories": categories[]->{
          "title": title[language == $lang][0].value,
          "slug": slug.current
        }
      }
      `,
      { lang },
    );

    for (const post of posts) {
      paths.push({
        params: {
          lang,
          slug: post.slug,
        },
        props: {
          post,
        },
      });
    }
  }

  return paths;
}

const locale = Astro.params.lang;
const { post } = Astro.props;
const publishedDate = post.publishedAt || post._createdAt;
const categories = post.categories || [];
const primaryCategory = categories[0];
const copyrightUrl = "https://creativecommons.org/licenses/by-nc-sa/4.0/";
const copyrightLabel = "CC BY-NC-SA 4.0";
const plainText = toPlainText(post.body || []);
const wordCount = plainText.trim().split(/\s+/).filter(Boolean).length;
const estimatedReadingMinutes = Math.max(1, Math.ceil(wordCount / 200));
const readingMinutes = post.duration || estimatedReadingMinutes;
const readingTime = `${readingMinutes} min read`;
const headingLevels = ["h2", "h3", "h4", "h5", "h6"];
const tableOfContents = (post.body || [])
  .filter((block) => block._type === "block" && headingLevels.includes(block.style))
  .map((block) => ({
    id: `section-${block._key}`,
    text: toPlainText([block]),
    level: Number(block.style.replace("h", "")),
  }))
  .filter((item) => item.text);
const canonicalUrl = new URL(`/${locale}/blog/${post.slug}`, SITE_URL).toString();
const canonicalUrlOverride = post.canonicalUrl || canonicalUrl;
const categoryUrl = primaryCategory
  ? new URL(`/${locale}/blog/${primaryCategory.slug}`, SITE_URL).toString()
  : new URL(`/${locale}/blog`, SITE_URL).toString();
const absoluteImage = post.image ? new URL(post.image, SITE_URL).toString() : undefined;
const socialImage = post.socialImage || post.image;
const articleTags = categories.map((category) => category.title).filter(Boolean);
const seoTitle = post.seoTitle || post.title;
const seoDescription = post.seoDescription || post.description;
const socialTitle = post.ogTitle || seoTitle;
const socialDescription = post.ogDescription || seoDescription;
const faqItems = (post.enableFaqSchema === false ? [] : post.faqs || [])
  .filter((item) => item?.question && item?.answer)
  .map((item) => ({
    question: item.question,
    answer: item.answer,
  }));
const alternateUrls = (post.alternatePosts || [])
  .filter((alternate) => alternate?.language && alternate?.slug)
  .map((alternate) => ({
    lang: alternate.language,
    url: `/${alternate.language}/blog/${alternate.slug}`,
  }));
const articleSchema = [
  {
    "@type": "Article",
    "@id": `${canonicalUrlOverride}#article`,
    headline: post.title,
    description: seoDescription || post.description,
    image: absoluteImage ? [absoluteImage] : undefined,
    datePublished: publishedDate,
    dateModified: post._updatedAt || publishedDate,
    author: post.author
      ? {
          "@type": "Person",
          name: post.author.name,
          url: new URL(`/${locale}/authors/${post.author.slug}`, SITE_URL).toString(),
        }
      : {
          "@type": "Organization",
          name: SITE_TITLE,
          url: SITE_URL,
        },
    publisher: {
      "@id": `${SITE_URL}/#organization`,
    },
    mainEntityOfPage: {
      "@id": `${canonicalUrlOverride}#webpage`,
    },
    articleSection: primaryCategory?.title,
    keywords: articleTags.join(", "),
    wordCount,
    timeRequired: `PT${readingMinutes}M`,
    about: articleTags.map((name) => ({
      "@type": "Thing",
      name,
    })),
    isAccessibleForFree: true,
    license: copyrightUrl,
    inLanguage: locale,
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrlOverride}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL(`/${locale}`, SITE_URL).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Magazine",
        item: new URL(`/${locale}/blog`, SITE_URL).toString(),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: primaryCategory?.title || "Article",
        item: categoryUrl,
      },
      {
        "@type": "ListItem",
        position: 4,
        name: post.title,
        item: canonicalUrlOverride,
      },
    ],
  },
];

const relatedPosts = await client.fetch(
  `
  *[
    _type == "post"
    && language == $lang
    && slug.current != $currentSlug
  ]
  | order(_createdAt desc)[0...3]{
    title,
    description,
    duration,
    publishedAt,
    _createdAt,

    "slug": slug.current,

    "image": thumbnail.asset->url,

    "author": author->{
      name,
      slug
    },

    "categories": categories[0]->{
      "title": title[language == $lang][0].value,
      slug
    }
  }
  `,
  {
    lang: locale,
    currentSlug: post.slug,
  },
);

const socials = [
  {
    url: "#",
    title: "Instagram",
    icon: "fa-brands fa-instagram",
  },
  {
    url: "#",
    title: "Twitter",
    icon: "fa-brands fa-x-twitter",
  },
  {
    url: "#",
    title: "Youtube",
    icon: "fa-brands fa-youtube",
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription || post.description}
  image={socialImage}
  imageAlt={post.socialImageAlt || post.imageAlt || post.title}
  socialTitle={socialTitle}
  socialDescription={socialDescription || seoDescription || post.description}
  canonicalUrl={canonicalUrlOverride}
  alternateUrls={alternateUrls}
  type="article"
  publishedTime={publishedDate}
  modifiedTime={post._updatedAt || publishedDate}
  author={post.author?.name}
  tags={articleTags}
  schema={articleSchema}
  faqItems={faqItems}
  noindex={post.noindex}
>
  <section class="mt-10">
    <div class="container">
      <div class="flex itms-center justify-between flex-wrap gap-4">
        <a
          href={`/${locale}/blog`}
          class="btn btn-link text-inherit uppercase no-underline group p-0"
          ><i class="fa-solid fa-arrow-left group-hover:translate-x-1"></i> Go Back
        </a>
        <p class="font-semibold text-3xl uppercase">Magazine</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="article-hero mx-auto max-w-5xl">
        <div class="flex flex-wrap gap-2 mb-6">
          <span class="badge badge-neutral uppercase">Featured</span>
          {primaryCategory && <span class="badge badge-outline uppercase">{primaryCategory.title}</span>}
        </div>
        <h1>{post.title}</h1>
        {post.description && <p class="text-lg md:text-xl font-semibold mt-6 max-w-3xl">{post.description}</p>}

        <div class="article-meta mt-8">
          {
            post.author && (
              <a href={`/${locale}/authors/${post.author.slug}`} class="font-semibold hover:underline">
                {post.author.name}
              </a>
            )
          }
          <span>{formatDate(publishedDate)}</span>
          <span>{readingTime}</span>
        </div>

        <div class="article-license mt-5">
          <b>Copyright:</b>
          <a href={copyrightUrl} target="_blank" rel="noopener noreferrer">
            {copyrightLabel}
          </a>
        </div>

        {
          categories.length > 0 && (
            <nav class="article-tags mt-5" aria-label="Article tags">
              {categories.map((category) => (
                <a href={`/${locale}/blog/${category.slug}`}>{category.title}</a>
              ))}
            </nav>
          )
        }

        <div class="mt-10">
        <Image
          src={post.image}
          alt={post.imageAlt || post.title}
          width="1200"
          height="600"
          format="webp"
          fetchpriority="high"
          quality={45}
          loading="eager"
          class="aspect-2/1 w-full h-auto object-cover"
        />
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div
        class="article-shell mx-auto grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_280px] gap-x-16 gap-y-10"
      >
        {
          post.body && (
            <article class="post max-w-3xl">
              <PortableComponent body={post.body} />
              {
                faqItems.length > 0 && (
                  <section class="article-faq mt-12" id="faq">
                    <h2>FAQs</h2>
                    <div class="grid gap-4 mt-6">
                      {faqItems.map((item) => (
                        <details class="article-faq-item">
                          <summary>{item.question}</summary>
                          <p>{item.answer}</p>
                        </details>
                      ))}
                    </div>
                  </section>
                )
              }
            </article>
          )
        }
        <aside class="article-toc">
          {
            tableOfContents.length > 0 && (
              <nav aria-label="On this page">
                <p>On This Page</p>
                <ol>
                  {tableOfContents.map((item) => (
                    <li class={`toc-level-${item.level}`}>
                      <a href={`#${item.id}`}>{item.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }

          <div class="article-share">
            <b>Share</b>
            <nav class="flex items-center gap-3 flex-wrap">
              {
                socials.map((icon) => (
                  <a
                    href={icon.url}
                    title={icon.title}
                    class="hover:rotate-12"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <i class={icon.icon} />
                  </a>
                ))
              }
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {
    relatedPosts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="border-t pt-10">
            <div class="flex flex-wrap gap-4 justify-between items-center">
              <h2 class="uppercase">Latest Posts</h2>
              <a
                href={`/${locale}/podcast`}
                class="btn btn-link text-inherit uppercase no-underline group p-0"
              >
                See all
                <i class="fa-solid fa-arrow-right group-hover:translate-x-1" />
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mt-10">
              {relatedPosts.map((post) => (
                <PostCardBase {...post} />
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <script is:inline>
    (() => {
      const links = Array.from(document.querySelectorAll(".article-toc a"));
      if (!links.length) return;

      const headings = links
        .map((link) => document.getElementById(link.hash.slice(1)))
        .filter(Boolean);

      if (!headings.length) return;

      const setCurrent = (id) => {
        links.forEach((link) => {
          const isCurrent = link.hash === `#${id}`;
          if (isCurrent) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

          if (visible[0]) setCurrent(visible[0].target.id);
        },
        { rootMargin: "-20% 0px -65% 0px" },
      );

      headings.forEach((heading) => observer.observe(heading));
      setCurrent(headings[0].id);
    })();
  </script>
</Layout>
