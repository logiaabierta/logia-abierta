---
import Image from "astro/components/Image.astro";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../../../layouts/Base.astro";
import PostCardBase from "../../../components/PostCardBase.astro";
import { formatDate } from "../../../utils/dateFormatter";
import { SITE_TITLE, SITE_URL } from "../../../consts";
import { LOCALES } from "../../../i18n";
import { getBlogPosts, getHeadingsFromMarkdown } from "../../../lib/editorialContent";

export async function getStaticPaths() {
  const paths = [];

  for (const lang of Object.keys(LOCALES)) {
    const posts = await getBlogPosts(lang);

    for (const post of posts) {
      const { Content } = await render(post.entry);
      paths.push({
        params: {
          lang,
          slug: post.slug,
        },
        props: {
          post,
          Content,
        },
      });
    }
  }

  return paths;
}

const locale = Astro.params.lang;
const { post, Content } = Astro.props;
const publishedDate = post.date;
const categories = post.category ? [post.category] : [];
const primaryCategory = post.category;
const copyrightUrl = "https://creativecommons.org/licenses/by-nc-sa/4.0/";
const copyrightLabel = "CC BY-NC-SA 4.0";
const plainText = post.entry.body || "";
const wordCount = plainText.trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = post.duration;
const readingTime = `${readingMinutes} min read`;
const tableOfContents = getHeadingsFromMarkdown(post.entry.body || "");
const canonicalUrl = new URL(`/${locale}/blog/${post.slug}`, SITE_URL).toString();
const canonicalUrlOverride = post.canonicalUrl || canonicalUrl;
const categoryUrl = primaryCategory
  ? new URL(`/${locale}/blog/${primaryCategory.slug}`, SITE_URL).toString()
  : new URL(`/${locale}/blog`, SITE_URL).toString();
const imageSource = typeof post.image === "string" ? post.image : post.image.src;
const absoluteImage = imageSource ? new URL(imageSource, SITE_URL).toString() : undefined;
const socialImage = post.ogImageUrl || post.image;
const articleTags = [
  ...categories.map((category) => category.title).filter(Boolean),
  ...(post.tags || []),
];
const seoTitle = post.ogTitle || post.title;
const seoDescription = post.ogDescription || post.description;
const socialTitle = post.ogTitle || seoTitle;
const socialDescription = post.ogDescription || seoDescription;
const faqItems = (post.faqs || [])
  .filter((item) => item?.question && item?.answer)
  .map((item) => ({
    question: item.question,
    answer: item.answer,
  }));
const articleSchema = [
  {
    "@type": "Article",
    "@id": `${canonicalUrlOverride}#article`,
    headline: post.title,
    description: seoDescription || post.description,
    image: absoluteImage ? [absoluteImage] : undefined,
    datePublished: publishedDate,
    dateModified: post.updatedDate || publishedDate,
    author: post.author
      ? {
          "@type": "Person",
          name: post.author.name,
          url: new URL(`/${locale}/authors/${post.author.slug}`, SITE_URL).toString(),
        }
      : {
          "@type": "Organization",
          name: SITE_TITLE,
          url: SITE_URL,
        },
    publisher: {
      "@id": `${SITE_URL}/#organization`,
    },
    mainEntityOfPage: {
      "@id": `${canonicalUrlOverride}#webpage`,
    },
    articleSection: primaryCategory?.title,
    keywords: articleTags.join(", "),
    wordCount,
    timeRequired: `PT${readingMinutes}M`,
    about: articleTags.map((name) => ({
      "@type": "Thing",
      name,
    })),
    isAccessibleForFree: true,
    license: copyrightUrl,
    inLanguage: locale,
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrlOverride}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL(`/${locale}`, SITE_URL).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Magazine",
        item: new URL(`/${locale}/blog`, SITE_URL).toString(),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: primaryCategory?.title || "Article",
        item: categoryUrl,
      },
      {
        "@type": "ListItem",
        position: 4,
        name: post.title,
        item: canonicalUrlOverride,
      },
    ],
  },
];

const relatedPosts = (await getBlogPosts(locale))
  .filter((relatedPost) => relatedPost.slug !== post.slug)
  .slice(0, 3);

const socials = [
  {
    url: "#",
    title: "Instagram",
    icon: "simple-icons:instagram",
  },
  {
    url: "#",
    title: "Twitter",
    icon: "simple-icons:x",
  },
  {
    url: "#",
    title: "Youtube",
    icon: "simple-icons:youtube",
  },
];
---

<Layout
  title={seoTitle}
  description={seoDescription || post.description}
  image={socialImage}
  imageAlt={post.imageAlt || post.title}
  socialTitle={socialTitle}
  socialDescription={socialDescription || seoDescription || post.description}
  canonicalUrl={canonicalUrlOverride}
  type="article"
  publishedTime={publishedDate}
  modifiedTime={post.updatedDate || publishedDate}
  author={post.author?.name}
  tags={articleTags}
  schema={articleSchema}
  faqItems={faqItems}
>
  <section class="mt-10">
    <div class="container">
      <div class="flex itms-center justify-between flex-wrap gap-4">
        <a
          href={`/${locale}/blog`}
          class="btn btn-link text-inherit uppercase no-underline group p-0"
          ><Icon name="lucide:arrow-left" aria-hidden="true" class="size-4 transition group-hover:translate-x-1" /> Go Back
        </a>
        <p class="font-semibold text-3xl uppercase">Magazine</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="article-hero mx-auto max-w-5xl" data-motion-reveal>
        <div class="flex flex-wrap gap-2 mb-6">
          {post.featured && <span class="badge badge-neutral uppercase">Featured</span>}
          {primaryCategory && <span class="badge badge-outline uppercase">{primaryCategory.title}</span>}
        </div>
        <h1>{post.title}</h1>
        {post.description && <p class="text-lg md:text-xl font-semibold mt-6 max-w-3xl">{post.description}</p>}

        <div class="article-meta mt-8">
          {
            post.author && (
              <a href={`/${locale}/authors/${post.author.slug}`} class="font-semibold hover:underline">
                {post.author.name}
              </a>
            )
          }
          <span>{formatDate(publishedDate)}</span>
          <span>{readingTime}</span>
        </div>

        <div class="article-license mt-5">
          <b>Copyright:</b>
          <a href={copyrightUrl} target="_blank" rel="noopener noreferrer">
            {copyrightLabel}
          </a>
        </div>

        {
          categories.length > 0 && (
            <nav class="article-tags mt-5" aria-label="Article tags">
              {categories.map((category) => (
                <a href={`/${locale}/blog/${category.slug}`}>{category.title}</a>
              ))}
            </nav>
          )
        }

        <div class="mt-10">
          <Image
            src={post.image}
            alt={post.imageAlt || post.title}
            width="1200"
            height="600"
            format="webp"
            fetchpriority="high"
            quality={45}
            loading="eager"
            class="aspect-2/1 w-full h-auto object-cover"
          />
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div
        class="article-shell mx-auto grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_280px] gap-x-16 gap-y-10"
      >
        <article class="post max-w-3xl" data-motion-reveal>
          <Content />
          {
            faqItems.length > 0 && (
              <section class="article-faq mt-12" id="faq">
                <h2>FAQs</h2>
                <div class="grid gap-4 mt-6">
                  {faqItems.map((item) => (
                    <details class="article-faq-item">
                      <summary>{item.question}</summary>
                      <p>{item.answer}</p>
                    </details>
                  ))}
                </div>
              </section>
            )
          }
        </article>
        <aside class="article-toc">
          {
            tableOfContents.length > 0 && (
              <>
                <button
                  type="button"
                  class="article-toc-toggle"
                  data-toc-toggle
                  aria-expanded="false"
                  aria-controls="article-toc-panel"
                  aria-label="Open article navigation"
                >
                  <Icon name="lucide:list" aria-hidden="true" class="size-4" />
                </button>
                <nav id="article-toc-panel" aria-label="On this page" data-toc-panel>
                  <p>On This Page</p>
                  <ol>
                    {tableOfContents.map((item) => (
                      <li class={`toc-level-${item.level}`}>
                        <a href={`#${item.id}`}>{item.text}</a>
                      </li>
                    ))}
                  </ol>
                </nav>
              </>
            )
          }

          <div class="article-share">
            <b>Share</b>
            <nav class="flex items-center gap-3 flex-wrap">
              {
                socials.map((icon) => (
                  <a
                    href={icon.url}
                    title={icon.title}
                    class="hover:rotate-12"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name={icon.icon} aria-hidden="true" class="size-4" />
                  </a>
                ))
              }
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {
    relatedPosts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="border-t pt-10">
            <div class="flex flex-wrap gap-4 justify-between items-center">
              <h2 class="uppercase">Latest Posts</h2>
              <a
                href={`/${locale}/blog`}
                class="btn btn-link text-inherit uppercase no-underline group p-0"
              >
                See all
                <Icon name="lucide:arrow-right" aria-hidden="true" class="size-4 transition group-hover:translate-x-1" />
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mt-10">
              {relatedPosts.map((post) => (
                <PostCardBase {...post} />
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <script is:inline>
    (() => {
      const tocToggle = document.querySelector("[data-toc-toggle]");
      const tocPanel = document.querySelector("[data-toc-panel]");
      if (tocToggle && tocPanel) {
        const setOpen = (isOpen) => {
          tocPanel.dataset.open = String(isOpen);
          tocToggle.setAttribute("aria-expanded", String(isOpen));
        };

        tocToggle.addEventListener("click", () => {
          setOpen(tocPanel.dataset.open !== "true");
        });

        tocPanel.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setOpen(false));
        });
      }

      const links = Array.from(document.querySelectorAll(".article-toc a"));
      if (!links.length) return;

      const headings = links
        .map((link) => document.getElementById(link.hash.slice(1)))
        .filter(Boolean);

      if (!headings.length) return;

      const setCurrent = (id) => {
        links.forEach((link) => {
          const isCurrent = link.hash === `#${id}`;
          if (isCurrent) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

          if (visible[0]) setCurrent(visible[0].target.id);
        },
        { rootMargin: "-20% 0px -65% 0px" },
      );

      headings.forEach((heading) => observer.observe(heading));
      setCurrent(headings[0].id);
    })();
  </script>
</Layout>
