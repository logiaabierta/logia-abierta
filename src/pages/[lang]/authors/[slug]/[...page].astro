---
import { Icon } from "astro-icon/components";
import Layout from "../../../../layouts/Base.astro";
import { client } from "../../../../lib/sanity";
import Card from "../../../../components/AuthorBlogCard.astro";
import PortableComponent from "../../../../components/builder/PortableComponent.astro";
import Pagination from "../../../../components/Pagination.astro";

import { LOCALES } from "../../../../i18n";

export async function getStaticPaths({ paginate }) {
  const paths = [];

  for (const lang of Object.keys(LOCALES)) {
    const authors = await client.fetch(
      `*[
        _type == "author" &&
        defined(slug.current) &&
        $lang in coalesce(activeLanguages, [language, "es"])
      ]{
        name,
        "activeLanguages": coalesce(activeLanguages, [language, "es"]),
        showMasonicProfile,
        primaryRites,
        craftBodies,
        philosophicalBodies,
        appendantBodies,
        honors,
        personalWebsite,
        publicEmail,
        contacts,
        bio,
        "description": coalesce(descriptionLocalized[language == $lang][0].value, descriptionLocalized[language == "es"][0].value, shortBio[language == $lang][0].value, shortBio[language == "es"][0].value, description),
        "shortBio": coalesce(shortBio[language == $lang][0].value, shortBio[language == "es"][0].value, description),
        "city": coalesce(
          select(defined(cityName) && defined(country) => cityName + ", " + country),
          cityName,
          country,
          otherLocation,
          cityLocalized[language == $lang][0].value,
          cityLocalized[language == "es"][0].value,
          city
        ),
        "job": coalesce(jobLocalized[language == $lang][0].value, jobLocalized[language == "es"][0].value, job),
        "bioText": coalesce(bioLocalized[language == $lang][0].value, bioLocalized[language == "es"][0].value),
        "masonicNotes": coalesce(masonicNotes[language == $lang][0].value, masonicNotes[language == "es"][0].value),
        "slug": slug.current,
        "image": image.asset->url
      }`,
      { lang },
    );

    for (const author of authors) {
      const posts = await client.fetch(
        `
    *[
      _type == "post" &&
      language == $lang &&
      author->slug.current == $slug
    ]
    | order(_createdAt desc){
      title,
      duration,
      _createdAt,
      "slug": slug.current,
      "image": thumbnail.asset->url
    }
    `,
        {
          lang,
          slug: author.slug,
        },
      );

      const paginated = paginate(posts, {
        pageSize: 4,
        params: {
          lang,
          slug: author.slug,
        },
        props: {
          author,
        },
      });

      paths.push(...paginated);
    }
  }

  return paths;
}

const locale = Astro.params.lang;

const { page, author } = Astro.props;

if (!author) {
  throw new Error("Author not found");
}

const posts = page.data;

const currentPage = page.currentPage;

const totalPages = page.lastPage;

const languageBadges = (author.activeLanguages || []).map((language) => String(language).toUpperCase());
const masonicGroups = [
  {title: "Ritos / sistemas", badges: author.primaryRites || []},
  {title: "Craft", badges: author.craftBodies || []},
  {title: "Cuerpos filosóficos", badges: author.philosophicalBodies || []},
  {title: "Appendant bodies", badges: author.appendantBodies || []},
  {title: "Distinciones", badges: author.honors || []},
].filter((group) => group.badges.length > 0);
const hasPublicMasonicProfile = author.showMasonicProfile !== false && masonicGroups.length > 0;
const contacts = author.contacts || [];
const getContactIcon = (icon = "", network = "") => {
  const value = `${icon} ${network}`.toLowerCase();

  if (value.includes("instagram")) return "simple-icons:instagram";
  if (value.includes("twitter") || value.includes("x-twitter")) return "simple-icons:x";
  if (value.includes("youtube")) return "simple-icons:youtube";
  if (value.includes("facebook")) return "simple-icons:facebook";
  if (value.includes("linkedin")) return "simple-icons:linkedin";
  if (value.includes("bluesky")) return "simple-icons:bluesky";
  if (value.includes("mastodon")) return "simple-icons:mastodon";
  if (value.includes("threads")) return "simple-icons:threads";
  if (value.includes("substack")) return "simple-icons:substack";
  if (value.includes("spotify")) return "simple-icons:spotify";
  if (value.includes("tiktok")) return "simple-icons:tiktok";
  if (value.includes("pinterest")) return "simple-icons:pinterest";
  if (value.includes("tumblr")) return "simple-icons:tumblr";
  if (value.includes("discord")) return "simple-icons:discord";
  if (value.includes("mail") || value.includes("email") || value.includes("envelope")) return "lucide:mail";

  return "lucide:link";
};
---

<Layout
  title={author.name}
  description={author.description}
  image={author?.image || ""}
>
  <section class="mt-10">
    <div class="container">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <a
          href={`/${locale}/authors`}
          class="btn btn-link text-inherit uppercase no-underline group p-0"
        >
          <Icon name="lucide:arrow-left" aria-hidden="true" class="size-4 transition group-hover:translate-x-1" />
          Go Back
        </a>

        <p class="font-semibold text-3xl uppercase">Author</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div
        class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[350px_1fr] gap-x-20 gap-y-10"
      >
        <aside>
          {
            author && (
              <img
                src={author.image}
                alt={author.name}
                class="rounded-full h-auto mx-auto w-full max-w-[350px] aspect-square object-cover"
              />
            )
          }

          {(contacts.length > 0 || author.personalWebsite || author.publicEmail) && (
            <div
              class="border-t pt-5 mt-10 flex flex-wrap items-center justify-between gap-4"
            >
              <p class="font-semibold uppercase">Follow</p>

              <nav class="flex items-center gap-3 flex-wrap">
                {author.personalWebsite && (
                  <a
                    href={author.personalWebsite}
                    title="Website"
                    class="hover:rotate-12"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name="lucide:link" aria-hidden="true" class="size-4" />
                  </a>
                )}
                {author.publicEmail && (
                  <a
                    href={`mailto:${author.publicEmail}`}
                    title="Email"
                    class="hover:rotate-12"
                  >
                    <Icon name="lucide:mail" aria-hidden="true" class="size-4" />
                  </a>
                )}
                {contacts.map((contact) => (
                  <a
                    href={contact.link}
                    title={contact.network}
                    class="hover:rotate-12"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name={getContactIcon(contact.icon, contact.network)} aria-hidden="true" class="size-4" />
                  </a>
                ))}
              </nav>
            </div>
          )}
        </aside>

        <div>
          <div class="max-w-md">
            <h1 class="mb-6">{author.name}</h1>

            <div class="flex flex-wrap gap-x-6 gap-y-3 items-center">
              <p>
                <b class="mr-2">Job</b>
                <span>{author.job}</span>
              </p>

              <p>
                <b class="mr-2">City</b>
                <span>{author.city}</span>
              </p>
            </div>

            {languageBadges.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2">
                {languageBadges.map((badge) => <span class="author-badge">{badge}</span>)}
              </div>
            )}
          </div>

          {
            (author.shortBio || author.description) && (
              <p class="text-lg my-10 font-semibold">{author.shortBio || author.description}</p>
            )
          }

          {hasPublicMasonicProfile && (
            <div class="my-10 grid gap-5 border-y py-6">
              {masonicGroups.map((group) => (
                <div class="grid gap-2 md:grid-cols-[170px_1fr] md:items-start">
                  <p class="text-sm font-bold uppercase opacity-70">{group.title}</p>
                  <div class="flex flex-wrap gap-2">
                    {group.badges.map((badge) => (
                      <span class="author-badge author-badge-masonic">{badge}</span>
                    ))}
                  </div>
                </div>
              ))}
              {author.masonicNotes && (
                <p class="text-sm leading-relaxed opacity-80">{author.masonicNotes}</p>
              )}
            </div>
          )}

          {
            author.bioText ? (
              <div class="prose prose-lg max-w-none mt-10">
                {author.bioText.split("\n").map((paragraph) => paragraph.trim() && <p>{paragraph}</p>)}
              </div>
            ) : author?.bio && (
              <div class="prose prose-lg max-w-none mt-10">
                <PortableComponent body={author.bio} />
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>
  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="border-t pt-10">
            <h2 class="uppercase">Articles by {author.name}</h2>
            <div class="grid grid-cols-1 lg:grid-cols-2 mt-10">
              {posts.map((post) => (
                <Card {...post} />
              ))}
            </div>

            {totalPages > 1 && (
              <div class="my-10">
                <Pagination totalPages={totalPages} page={page} />
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }
</Layout>
