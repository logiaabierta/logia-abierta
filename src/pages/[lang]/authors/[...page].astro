---
import Layout from "../../../layouts/Base.astro";
import Hero from "../../../components/Hero.astro";
import AuthorCardRow from "../../../components/AuthorCardRow.astro";
import Pagination from "../../../components/Pagination.astro";

import { getCollection } from "astro:content";
import { LOCALES } from "../../../i18n";

export async function getStaticPaths({ paginate }) {
  const paths = [];

  for (const lang of Object.keys(LOCALES)) {
    const authors = (await getCollection("authors"))
      .filter((author) => (author.data.languages || ["es"]).includes(lang))
      .map((author) => ({
        name: author.data.publicName,
        activeLanguages: author.data.languages,
        showMasonicProfile: true,
        primaryRites: author.data.rites,
        craftBodies: [],
        philosophicalBodies: [],
        appendantBodies: [],
        honors: [],
        city: [author.data.city, author.data.country].filter(Boolean).join(", "),
        job: author.data.archetype !== "otro" ? author.data.archetype : "",
        description: author.data.bio,
        slug: author.id.replace(/\.json$/, ""),
        image: author.data.avatarImage?.src || author.data.avatarUrl,
        imageAlt: author.data.avatarImage?.alt || author.data.avatarAlt,
      }))
      .sort((a, b) => a.name.localeCompare(b.name, lang));

    const paginated = paginate(authors, {
      pageSize: 6,

      params: {
        lang,
      },
    });

    paths.push(...paginated);
  }

  return paths;
}

const locale = Astro.params.lang;

const { page } = Astro.props;

const totalPages = Math.ceil(page.total / page.size);
---

<Layout title="Authors">
  <Hero title="Authors" />

  <section class="section">
    <div class="container">
      <ul class="grid gap-10 mb-10">
        {
          page.data.map((post) => (
            <li class="border-b pb-10 last:border-b-0 last:pb-0">
              <AuthorCardRow {...post} />
            </li>
          ))
        }
      </ul>

      {totalPages > 1 && <Pagination totalPages={totalPages} page={page} />}
    </div>
  </section>
</Layout>
