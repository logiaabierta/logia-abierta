---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Base.astro";
import { formatDate } from "../../../utils/dateFormatter";
import { LOCALES } from "../../../i18n";

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));

const locale = Astro.params.lang;
const essays = (await getCollection("essays"))
  .filter((entry) => entry.data.lang === locale)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Ensayos"
  description="Ensayos MDX interactivos de Logia Abierta con diagramas, presentaciones y contenido optimizado para búsqueda generativa."
>
  <section class="section">
    <div class="container">
      <div class="flex flex-wrap gap-4 justify-between items-end">
        <div>
          <h1>Ensayos</h1>
          <p class="mt-4 max-w-2xl text-lg font-semibold">
            Piezas MDX para diagramas, presentaciones y contenido interactivo.
          </p>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          essays.map((entry) => (
            <article class="border p-6">
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="badge badge-neutral uppercase">MDX</span>
                {entry.data.featured && <span class="badge badge-outline uppercase">Featured</span>}
              </div>
              <a href={`/${locale}/ensayos/${entry.id.replace(/\.(md|mdx)$/, "")}`}>
                <h2 class="h3 hover:underline">{entry.data.title}</h2>
              </a>
              <p class="mt-3">{entry.data.description}</p>
              <p class="mt-5 text-sm opacity-70">{formatDate(entry.data.pubDate)}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
