---
import { getCollection } from "astro:content";

import Layout from "../../layouts/Base.astro";
import Topline from "../../components/Topline.astro";
import Demo from "../../components/DemoPost.astro";
import Posts from "../../components/Posts.astro";
import Podcasts from "../../components/Podcasts.astro";
import Authors from "../../components/Authors.astro";
import PuckPage from "../../components/puck/PuckPage.astro";
import { LOCALES } from "../../i18n";
const locale = Astro.currentLocale;

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));

const pages = await getCollection("puckPages", ({ data }) => data.status === "published");
const homePage = pages.find((page) => page.data.lang === locale && page.data.slug === "home");
const seo = homePage?.data.seo || {};
---

<Layout
  title={seo.title || homePage?.data.title || "Logia Abierta"}
  description={seo.description || homePage?.data.description}
  image={seo.image}
  canonicalUrl={seo.canonicalUrl}
  noindex={seo.noIndex}
>
  {homePage ? <PuckPage page={homePage} /> : null}
  <Topline />
  <Demo />
  <Posts />
  <Podcasts />
  <Authors />
</Layout>
