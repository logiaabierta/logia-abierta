---
import { Icon } from "astro-icon/components";
---

<button
  type="button"
  class="btn btn-square btn-ghost"
  data-theme-toggle
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <Icon name="lucide:moon" data-theme-icon="moon" class="size-4" aria-hidden="true" />
  <Icon name="lucide:sun" data-theme-icon="sun" class="hidden size-4" aria-hidden="true" />
</button>
