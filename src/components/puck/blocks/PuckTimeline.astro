---
const { eyebrow, title, events = [] } = Astro.props;
---

<section class="section puck-timeline" data-motion-reveal>
  <div class="container">
    {(eyebrow || title) && (
      <header class="puck-section-header">
        {eyebrow && <p class="puck-eyebrow">{eyebrow}</p>}
        {title && <h2>{title}</h2>}
      </header>
    )}
    <div class="puck-timeline-list">
      {events.map((event) => (
        <article>
          {event.year && <span>{event.year}</span>}
          <h3>{event.title}</h3>
          {event.text && <p>{event.text}</p>}
        </article>
      ))}
    </div>
  </div>
</section>
