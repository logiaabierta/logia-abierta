---
const { eyebrow, title, items = [] } = Astro.props;
---

<section class="section puck-faq" data-motion-reveal>
  <div class="container">
    {(eyebrow || title) && (
      <header class="puck-section-header">
        {eyebrow && <p class="puck-eyebrow">{eyebrow}</p>}
        {title && <h2>{title}</h2>}
      </header>
    )}
    <div class="puck-faq-list">
      {items.map((item, index) => (
        <details open={index === 0}>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
