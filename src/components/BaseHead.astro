---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/og-1200x630.jpg";
import { r2Asset } from "../lib/r2Assets";
import {
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_KEYWORDS,
  SITE_LOCALE,
  SITE_TITLE,
  SITE_TOPICS,
  SITE_URL,
} from "../consts";
import { Font } from "astro:assets";
interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
  faqItems?: Array<{ question: string; answer: string }>;
  noindex?: boolean;
  canonicalUrl?: string;
  socialTitle?: string;
  socialDescription?: string;
  imageAlt?: string;
  alternateUrls?: Array<{ lang: string; url: string }>;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = FallbackImage,
  type = "website",
  publishedTime,
  modifiedTime,
  author = SITE_AUTHOR,
  tags = [],
  schema = [],
  faqItems = [],
  noindex = false,
  canonicalUrl,
  socialTitle,
  socialDescription,
  imageAlt,
  alternateUrls = [],
} = Astro.props;
const site = Astro.site || new URL(SITE_URL);
const canonicalURL = canonicalUrl ? new URL(canonicalUrl, site) : new URL(Astro.url.pathname, site);
const pageTitle = title === SITE_TITLE ? SITE_TITLE : `${title} | ${SITE_TITLE}`;
const socialMetaTitle = socialTitle || pageTitle;
const socialMetaDescription = socialDescription || description;
const imagePath =
  typeof image === "string"
    ? r2Asset(image)
    : image === FallbackImage
      ? r2Asset("/src/assets/og-1200x630.jpg")
      : image.src;
const ogImage = new URL(imagePath, site);
const ogImageAlt = imageAlt || title;
const schemaItems = Array.isArray(schema) ? schema : [schema];
const faqSchema =
  faqItems.length > 0
    ? {
        "@type": "FAQPage",
        "@id": `${canonicalURL.toString()}#faq`,
        mainEntity: faqItems.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      }
    : null;
const baseSchema = [
  {
    "@type": "Organization",
    "@id": `${SITE_URL}/#organization`,
    name: SITE_TITLE,
    url: SITE_URL,
    logo: r2Asset("/favicon/web-app-manifest-512x512.png"),
    knowsAbout: SITE_TOPICS,
    sameAs: [],
  },
  {
    "@type": "WebSite",
    "@id": `${SITE_URL}/#website`,
    url: SITE_URL,
    name: SITE_TITLE,
    description: SITE_DESCRIPTION,
    publisher: {
      "@id": `${SITE_URL}/#organization`,
    },
    about: SITE_TOPICS.map((name) => ({
      "@type": "Thing",
      name,
    })),
    keywords: SITE_KEYWORDS.join(", "),
    inLanguage: Astro.currentLocale || "es",
  },
  {
    "@type": "WebPage",
    "@id": `${canonicalURL.toString()}#webpage`,
    url: canonicalURL.toString(),
    name: pageTitle,
    description,
    isPartOf: {
      "@id": `${SITE_URL}/#website`,
    },
    publisher: {
      "@id": `${SITE_URL}/#organization`,
    },
    about: [...SITE_TOPICS, ...tags].map((name) => ({
      "@type": "Thing",
      name,
    })),
    keywords: [...SITE_KEYWORDS, ...tags].join(", "),
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: ogImage.toString(),
    },
    inLanguage: Astro.currentLocale || "es",
  },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [...baseSchema, ...schemaItems.filter(Boolean), faqSchema].filter(Boolean),
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={r2Asset("/favicon.svg")} />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="text/plain" title="LLMs.txt" href="/llms.txt" />
<link rel="manifest" href="/favicon/site.webmanifest" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta
  name="robots"
  content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"}
/>
<meta name="author" content={author} />
<meta name="keywords" content={[...SITE_KEYWORDS, ...tags].join(", ")} />
<meta name="google-site-verification" content="h6VGYxhEOhOmuMFzCG5fdwriq92ruFSrs7Me4a-usXs" />
<meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{
  alternateUrls.map((alternate) => (
    <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.url, site).toString()} />
  ))
}
{
  alternateUrls.length > 0 && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternateUrls.find((alternate) => alternate.lang === "es")?.url || alternateUrls[0].url, site).toString()}
    />
  )
}

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={SITE_LOCALE} />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:title" content={socialMetaTitle} />
<meta property="og:description" content={socialMetaDescription} />
<meta property="og:image" content={ogImage.toString()} />
<meta property="og:image:secure_url" content={ogImage.toString()} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{author && <meta property="article:author" content={author} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL.toString()} />
<meta name="twitter:title" content={socialMetaTitle} />
<meta name="twitter:description" content={socialMetaDescription} />
<meta name="twitter:image" content={ogImage.toString()} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- Cookie consent -->
<script
  id="Cookiebot"
  src="https://consent.cookiebot.com/uc.js"
  data-cbid="58a8881e-6ec3-435c-8780-dd29169d188a"
  type="text/javascript"
  async
></script>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-GZ4FHV124L"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", "G-GZ4FHV124L");
</script>
