---
import { Icon } from "astro-icon/components";
import PodcastCard from "../components/PodcastCard.astro";
import { getCollection } from "astro:content";

const locale = Astro.currentLocale;

const podcasts = (await getCollection("podcasts"))
  .filter((podcast) => podcast.data.status === "published" && podcast.data.lang === locale)
  .map((podcast) => ({
    title: podcast.data.title,
    _createdAt: podcast.data.pubDate,
    duration: podcast.data.duration || 0,
    episod: podcast.data.episode || 0,
    slug: podcast.id.replace(/\.(md|mdx)$/, ""),
    image: podcast.data.thumbnailUrl,
  }))
  .sort((a, b) => new Date(b._createdAt).getTime() - new Date(a._createdAt).getTime())
  .slice(0, 3);
---

{
  podcasts?.length > 0 ? (
    <section class="section section-podcasts">
      <div class="container">
        <div class="border-t pt-8">
          <div class="flex flex-wrap gap-4 justify-between items-center">
            <h2 class="h1">Podcast</h2>
            <a
              href={`/${locale}/podcast`}
              class="btn btn-link text-inherit uppercase no-underline group p-0"
            >
              All Episodes
              <Icon name="lucide:arrow-right" aria-hidden="true" class="size-4 transition group-hover:translate-x-1" />
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols=2 lg:grid-cols-3 mt-10">
            {podcasts.map((podcast) => (
              <PodcastCard {...podcast} />
            ))}
          </div>
        </div>
      </div>
    </section>
  ) : null
}
