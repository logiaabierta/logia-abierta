---
import { Icon } from "astro-icon/components";
import PostCardRow from "../components/PostCardRow.astro";
import Subscribe from "../components/Subscride.astro";
import Banner from "../components/Banner.astro";
import MostPopularPosts from "../components/MostPopularPosts.astro";
import { getBlogPosts } from "../lib/editorialContent";
const locale = Astro.currentLocale;

const posts = (await getBlogPosts(locale)).slice(0, 6);
---

{
  posts.length > 0 ? (
    <section class="section section-posts">
      <div class="container">
        <div class="grid grid-cols-1 lg:grid-cols-[3fr_1fr] gap-10">
          <div>
            <div class="grid gap-10">
              {posts.map((post) => (
                <PostCardRow {...post} />
              ))}
            </div>
            <a
              href={`/${locale}/blog`}
              class="btn btn-link mt-10 text-inherit uppercase no-underline group p-0"
            >
              All articles
              <Icon name="lucide:arrow-right" aria-hidden="true" class="size-4 transition group-hover:translate-x-1" />
            </a>
          </div>
          <aside class="lg:flex flex-col gap-10 hidden">
            <Banner />

            <MostPopularPosts />

            <Subscribe />
          </aside>
        </div>
      </div>
    </section>
  ) : null
}
