---
import { getBlogPosts } from "../lib/editorialContent";

const locale = Astro.currentLocale;
const posts = (await getBlogPosts(locale)).slice(0, 3);
---

<div>
  <h4 class="uppercase font-semibold text-xl">Most Popular</h4>

  <ul class="grid">
    {posts.map((post, index) => (
      <li>
        <a href={`/${locale}/blog/${post.slug}`} class={`grid grid-cols-[4em_auto] py-5 ${index > 0 ? "border-t" : ""}`}>
          <div class="text-3xl font-semibold">{String(index + 1).padStart(2, "0")}</div>
          <div>
            <h5 class="font-semibold text-2xl mb-3">{post.title}</h5>
            {post.author && (
              <p>
                <b class="mr-2">Text</b>
                <span>{post.author.name}</span>
              </p>
            )}
          </div>
        </a>
      </li>
    ))}
  </ul>
</div>
