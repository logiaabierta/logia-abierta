---
import Image from "astro/components/Image.astro";
import { Icon } from "astro-icon/components";

const {
  name,
  city,
  job,
  slug,
  image,
  description,
  activeLanguages = [],
  showMasonicProfile = true,
  primaryRites = [],
  craftBodies = [],
  philosophicalBodies = [],
  appendantBodies = [],
  honors = [],
} = Astro.props;
const locale = Astro.currentLocale;
const languageBadges = (activeLanguages || []).map((language) => String(language).toUpperCase());
const masonicBadges =
  showMasonicProfile === false
    ? []
    : [
        ...new Set([
          ...(primaryRites || []),
          ...(craftBodies || []),
          ...(philosophicalBodies || []),
          ...(appendantBodies || []),
          ...(honors || []),
        ]),
      ].slice(0, 5);

---

<article>
  <a
    href={`/${locale}/authors/${slug}`}
    class="grid grid-cols-1 text-center lg:text-left lg:grid-cols-[150px_1fr] gap-10 items-center"
  >
    {image &&<Image
      src={image}
      alt={name}
      width="150"
      height="150"
      format="webp"
      quality={80}
      class="rounded-full aspect-square mx-auto h-auto"
    /> }

    <div
      class="mx-auto lg:mx-0 flex flex-wrap justify-center md:justify-between items-center"
    >
      <h3 class="mb-0">{name}</h3>

      <div
        class="flex flex-wrap gap-x-6 gap-y-3 justify-start items-center mt-4"
      >
        {job && <p>
          <b class="mr-2">Job</b>
          <span> {job} </span>
        </p>}
        {city && <p>
          <b class="mr-2">City</b>
          <span>{city}</span>
        </p>}
        <button
          class="btn btn-link text-inherit uppercase no-underline group p-0"
        >
          About
          <Icon name="lucide:arrow-right" aria-hidden="true" class="size-4 transition group-hover:translate-x-1" />
        </button>
      </div>
      {description && <p class="mt-4 text-sm opacity-70 basis-full">{description}</p>}
      {(languageBadges.length > 0 || masonicBadges.length > 0) && (
        <div class="mt-5 flex flex-wrap justify-center md:justify-start gap-2 basis-full">
          {languageBadges.map((badge) => <span class="author-badge">{badge}</span>)}
          {masonicBadges.map((badge) => <span class="author-badge author-badge-masonic">{badge}</span>)}
        </div>
      )}
    </div>
  </a>
</article>
