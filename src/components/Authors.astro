---
import { Icon } from "astro-icon/components";
import AuthorCard from "../components/AuthorCard.astro";
import { getCollection } from "astro:content";

const locale = Astro.currentLocale;

const authors = (await getCollection("authors"))
  .filter((author) => (author.data.languages || ["es"]).includes(locale))
  .map((author) => ({
    name: author.data.publicName,
    activeLanguages: author.data.languages,
    showMasonicProfile: true,
    primaryRites: author.data.rites,
    craftBodies: [],
    philosophicalBodies: [],
    appendantBodies: [],
    honors: [],
    city: [author.data.city, author.data.country].filter(Boolean).join(", "),
    job: author.data.archetype !== "otro" ? author.data.archetype : "",
    description: author.data.bio,
    slug: author.id.replace(/\.json$/, ""),
    image: author.data.avatarImage?.src || author.data.avatarUrl,
    imageAlt: author.data.avatarImage?.alt || author.data.avatarAlt,
  }))
  .sort((a, b) => a.name.localeCompare(b.name, locale))
  .slice(0, 6);

//console.log("authors", authors);
---

{
  authors?.length > 0 ? (
    <section class="section section-authors">
      <div class="container">
        <div class="border-t pt-8">
          <div class="flex flex-wrap gap-4 justify-between items-center">
            <h2 class="h1">Authors</h2>
            <a
              href={`/${locale}/authors`}
              class="btn btn-link text-inherit uppercase no-underline group p-0"
            >
              All Authors
              <Icon name="lucide:arrow-right" aria-hidden="true" class="size-4 transition group-hover:translate-x-1" />
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 mt-10">
            {authors.map((author) => (
              <AuthorCard {...author} />
            ))}
          </div>
        </div>
      </div>
    </section>
  ) : null
}
