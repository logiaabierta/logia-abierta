---
import AuthorCard from "../components/AuthorCard.astro";

import { client } from "../lib/sanity";
const locale = Astro.currentLocale;

const authors = await client.fetch(
  `
  *[
    _type == "author" &&
    defined(slug.current) &&
    $locale in coalesce(activeLanguages, [language, "es"])
  ] | order(_createdAt desc)[0...6]{
    name,
    "activeLanguages": coalesce(activeLanguages, [language, "es"]),
    showMasonicProfile,
    primaryRites,
    craftBodies,
    philosophicalBodies,
    appendantBodies,
    honors,
    "city": coalesce(
      select(defined(cityName) && defined(country) => cityName + ", " + country),
      cityName,
      country,
      otherLocation,
      cityLocalized[language == $locale][0].value,
      cityLocalized[language == "es"][0].value,
      city
    ),
    "job": coalesce(jobLocalized[language == $locale][0].value, jobLocalized[language == "es"][0].value, job),
    "description": coalesce(shortBio[language == $locale][0].value, shortBio[language == "es"][0].value, descriptionLocalized[language == $locale][0].value, descriptionLocalized[language == "es"][0].value, description),
    "slug": slug.current,
    "image": image.asset->url
  }
`,
  {
    locale,
  },
);

//console.log("authors", authors);
---

{
  authors?.length > 0 ? (
    <section class="section section-authors">
      <div class="container">
        <div class="border-t pt-8">
          <div class="flex flex-wrap gap-4 justify-between items-center">
            <h2 class="h1">Authors</h2>
            <a
              href={`/${locale}/authors`}
              class="btn btn-link text-inherit uppercase no-underline group p-0"
            >
              All Authors
              <i class="fa-solid fa-arrow-right group-hover:translate-x-1" />
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 mt-10">
            {authors.map((author) => (
              <AuthorCard {...author} />
            ))}
          </div>
        </div>
      </div>
    </section>
  ) : null
}
